# --- App ---
# Public site name shown in the UI.
NEXT_PUBLIC_SITE_NAME=Checkmate Coach

# SQLite database path. ":memory:" runs an in-memory DB (used by tests).
DATABASE_PATH=./data/chess.db

# --- Accounts & credits ---
# Secret used to sign login session cookies. Set this to a long random string.
AUTH_SECRET=change-me-to-a-long-random-string

# The admin account is created automatically on first run. Change these!
ADMIN_EMAIL=admin@checkmatecoach.app
ADMIN_PASSWORD=4fc4c8604a6348b7aa84d0285f3920e3

# --- Python analysis pipeline ---
# Base URL of the FastAPI service (service/main.py). The Next.js app talks to
# this over HTTP for game analysis and scoresheet OCR.
PYTHON_SERVICE_URL=http://127.0.0.1:8000

# Optional override for the python executable used by the CLI fallback path.
# PYTHON_BIN=python

# Path to the Stockfish engine binary (used inside the Python service).
STOCKFISH_PATH=stockfish

# --- LLM provider (DeepSeek and/or LibreChat — no OpenAI) ---
# "deepseek" (default) or "librechat"
AI_PROVIDER=deepseek

# DeepSeek (OpenAI-compatible chat completions)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# LibreChat agent gateway (Responses API)
LIBRECHAT_ENDPOINT=https://njxai.com
LIBRECHAT_API_KEY=
LIBRECHAT_MODEL=

# --- ChessAgent MCP server (game fetch + enrichment) ---
# Streamable-HTTP endpoint of the chess-agent MCP server (default port 8080).
CHESS_AGENT_MCP_URL=http://host.docker.internal:8080/mcp

# --- Cloudflare Tunnel (routes chess.njxai.com) ---
# Token from Cloudflare Zero Trust -> Networks -> Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Billing ---
# "false" = free for everyone (no paywall). "true" = force the paywall on.
# Leave unset to auto-enable billing only when Stripe keys are present.
BILLING_ENABLED=

# --- Stripe (test mode) ---
# Create a product + recurring price in the Stripe dashboard and copy its ID.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
